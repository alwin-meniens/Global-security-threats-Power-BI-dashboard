// CyberRisk Intelligence | Global Cybersecurity Threats (2015–2024)

Total Financial Impact =
SUM('Global_Cybersecurity_Threats_2015-2024'[Financial Loss (in Million $)])

Total Cybersecurity Incidents =
COUNTROWS('Global_Cybersecurity_Threats_2015-2024')

Average Response Time (Hours) =
AVERAGE('Global_Cybersecurity_Threats_2015-2024'[Incident Resolution Time (in Hours)])

Total Affected Users =
SUM('Global_Cybersecurity_Threats_2015-2024'[Number of Affected Users])

Total Data Breached (GB) =
SUM('Global_Cybersecurity_Threats_2015-2024'[Data Breached (GB)])

Financial Impact ($Bn) =
DIVIDE([Total Financial Impact], 1000, 0)

Average Loss per Incident ($M) =
DIVIDE([Total Financial Impact], [Total Cybersecurity Incidents], 0)

Average Affected Users per Incident =
DIVIDE([Total Affected Users], [Total Cybersecurity Incidents], 0)

Total Financial Impact (USD M) =
[Total Financial Impact]

Total Financial Impact (USD Bn) =
[Financial Impact ($Bn)]

Average Resolution Time (Hours) =
[Average Response Time (Hours)]

Total Breached Users =
[Total Affected Users]
